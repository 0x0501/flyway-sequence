{
  "name": "flyway-sequence",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build --mode prod",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "bun run db:migrate && wrangler deploy --keep-vars",
    "cf-typegen": "wrangler types",
    "auth:generate": "bunx auth@latest generate --config ./auth.config.ts --output ./src/db/schema/auth.ts --adapter drizzle --dialect sqlite -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/server": "2.3.1",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=24.0.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "lightningcss",
    "workerd"
  ]
}
